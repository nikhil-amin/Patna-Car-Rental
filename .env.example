# Copy to .env and replace the placeholder password before running the app.
APP_NAME=DriveEase
APP_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=carrental
DB_USER=driveease
DB_PASS=change-this-password

# Safer default: fleet-owner accounts should be created by an administrator.
ALLOW_ADMIN_SIGNUP=false
